# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/ambiental_db
DATABASE_URL_TEST=

# Security
SECRET_KEY=your-super-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment
ENVIRONMENT=development
DEBUG=True

# Initial admin bootstrap (used for first database seed)
INITIAL_ADMIN_EMAIL=admin@ambiental.local
INITIAL_ADMIN_FULL_NAME=Administrador Ambiental
INITIAL_ADMIN_PASSWORD=ChangeMe#123

# CORS
ALLOWED_ORIGINS_STR=http://localhost:3000,http://localhost:8080

# N8N Integration
N8N_WEBHOOK_URL=https://
N8N_JWT_TOKEN=
N8N_SIGNING_SECRET=change-this-in-production

# Deployment and Storage
DEPLOYMENT_MODE=saas
FILE_STORAGE_BACKEND=local_encrypted

# Encryption (generate with: python -c "from app.core.encryption import EncryptionUtils; print(EncryptionUtils.generate_key())")
FILE_ENCRYPTION_KEY=

# Email Configuration (for future use)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@ambiental.com
