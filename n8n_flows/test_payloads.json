    "in_upload": "curl -X POST https://seu-n8n.com/webhook/in-upload \\\n  -H 'Content-Type: application/json' \\\n  -H 'Authorization: Bearer eyJhbGc...' \\\n  -d '{\n    \"municipality\": \"Joinville\",\n    \"state\": \"SC\",\n    \"instruction_number\": \"IN-2024-001\",\n    \"version\": \"1.0\",\n    \"valid_from\": \"2024-01-01\",\n    \"content_text\": \"...\"\n  }'",
    
