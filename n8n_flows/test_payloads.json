  "flows": {
    "01_chat_orchestrator": {
      "url": "/chat-orchestrator",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <JWT_TOKEN>"
      },
      "examples": [
        {
          "name": "Pergunta simples",
          "payload": {
            "org_id": 1,
            "thread_id": 123,
            "user_id": 456,
            "message": "O que ainda falta para protocolar?",
            "files": [],
            "metadata": {}
          }
        },
        {
          "name": "Pergunta com contexto de arquivos",
          "payload": {
            "org_id": 1,
            "thread_id": 123,
            "user_id": 456,
            "message": "Esse projeto está dentro da IN atual de Joinville?",
            "files": [
              {
                "id": 789,
                "filename": "projeto_arquitetonico.pdf",
                "mime_type": "application/pdf"
              }
            ],
            "metadata": {
              "municipality": "Joinville",
              "state": "SC"
            }
          }
        },
        {
          "name": "Consulta sobre checklist",
          "payload": {
            "org_id": 1,
            "thread_id": 123,
            "user_id": 456,
            "message": "Me dá uma lista de tudo que falta",
            "files": [],
            "metadata": {}
          }
        }
      ]
    },
    
    "02_document_intake": {
      "url": "/document-intake",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <JWT_TOKEN>"
      },
      "examples": [
        {
          "name": "Upload de PDF",
          "payload": {
            "file_id": 789,
            "org_id": 1,
            "thread_id": 123,
            "filename": "projeto_arquitetonico.pdf",
            "file_path": "/uploads/chat_files/4/2/file789.pdf",
            "mime_type": "application/pdf",
            "file_size": 2048000
          }
        },
        {
          "name": "Upload de imagem (planta)",
          "payload": {
            "file_id": 790,
            "org_id": 1,
            "thread_id": 123,
            "filename": "planta_baixa.jpg",
            "file_path": "/uploads/chat_files/4/2/file790.jpg",
            "mime_type": "image/jpeg",
            "file_size": 512000
          }
        },
        {
          "name": "Upload de boleto",
          "payload": {
            "file_id": 791,
            "org_id": 1,
            "thread_id": 123,
            "filename": "boleto_taxa_ambiental.pdf",
            "file_path": "/uploads/chat_files/4/2/file791.pdf",
            "mime_type": "application/pdf",
            "file_size": 128000
          }
        },
        {
          "name": "Upload de documento do empreendedor",
          "payload": {
            "file_id": 792,
            "org_id": 1,
            "thread_id": 123,
            "filename": "cpf_empreendedor.pdf",
            "file_path": "/uploads/chat_files/4/2/file792.pdf",
            "mime_type": "application/pdf",
            "file_size": 64000
          }
        }
      ]
    },
    
    "03_timeline_updater": {
      "url": "/timeline-updater",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <JWT_TOKEN>"
      },
      "examples": [
        {
          "name": "Atualização após upload de documento",
          "payload": {
            "thread_id": 123,
            "org_id": 1,
            "event_type": "document_added",
            "file_id": 789
          }
        },
        {
          "name": "Atualização manual (forçada)",
          "payload": {
            "thread_id": 123,
            "org_id": 1,
            "event_type": "manual_update",
            "forced": true
          }
        },
        {
          "name": "Atualização após resposta da IA",
          "payload": {
            "thread_id": 123,
            "org_id": 1,
            "event_type": "ai_response",
            "message_id": 456
          }
        },
        {
          "name": "Recalcular após reprocessamento",
          "payload": {
            "thread_id": 123,
            "org_id": 1,
            "event_type": "reprocess",
            "forced": true
          }
        }
      ]
    },
    
    "04_in_upload": {
      "url": "/in-upload",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <ADMIN_JWT_TOKEN>"
      },
      "examples": [
        {
          "name": "Nova IN de Joinville",
          "payload": {
            "municipality": "Joinville",
            "state": "SC",
            "instruction_number": "IN-2024-001",
            "version": "1.0",
            "valid_from": "2024-01-01",
            "valid_until": null,
            "content_text": "Instrução Normativa para processos ambientais...",
            "content_url": "https://exemplo.com/in-2024-001.pdf",
            "metadata": {
              "category": "licenciamento",
              "department": "meio_ambiente"
            }
          }
        },
        {
          "name": "Atualização de versão existente",
          "payload": {
            "municipality": "Joinville",
            "state": "SC",
            "instruction_number": "IN-2024-001",
            "version": "2.0",
            "valid_from": "2024-06-01",
            "valid_until": null,
            "content_text": "Instrução Normativa ATUALIZADA para processos ambientais...",
            "content_url": "https://exemplo.com/in-2024-001-v2.pdf",
            "metadata": {
              "category": "licenciamento",
              "department": "meio_ambiente",
              "changes": "Novos requisitos para projetos acima de 1000m²"
            }
          }
        },
        {
          "name": "IN de Florianópolis",
          "payload": {
            "municipality": "Florianópolis",
            "state": "SC",
            "instruction_number": "FLORAM-IN-2024-015",
            "version": "1.0",
            "valid_from": "2024-03-15",
            "valid_until": "2025-03-14",
            "content_text": "Regulamentação ambiental específica de Florianópolis...",
            "content_url": "https://floram.floripa.sc.gov.br/in-2024-015.pdf",
            "metadata": {
              "category": "construcao_civil",
              "department": "floram"
            }
          }
        }
      ]
    },
    
    "05_admin_apis": {
      "list_processes": {
        "url": "/admin/list-processes",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer <ADMIN_JWT_TOKEN>"
        },
        "examples": [
          {
            "name": "Listar todos os processos",
            "payload": {
              "limit": 50,
              "offset": 0
            }
          },
          {
            "name": "Filtrar por organização",
            "payload": {
              "org_id": 1,
              "limit": 50,
              "offset": 0
            }
          },
          {
            "name": "Filtrar por município",
            "payload": {
              "municipality": "Joinville",
              "state": "SC",
              "limit": 50,
              "offset": 0
            }
          },
          {
            "name": "Paginação",
            "payload": {
              "org_id": 1,
              "limit": 10,
              "offset": 10
            }
          }
        ]
      },
      
      "reprocess": {
        "url": "/admin/reprocess",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer <ADMIN_JWT_TOKEN>"
        },
        "examples": [
          {
            "name": "Reprocessar thread específico",
            "payload": {
              "thread_id": 123,
              "org_id": 1,
              "force": false
            }
          },
          {
            "name": "Forçar reprocessamento completo",
            "payload": {
              "thread_id": 123,
              "org_id": 1,
              "force": true
            }
          }
        ]
      },
      
      "health": {
        "url": "/admin/health",
        "method": "GET",
        "headers": {},
        "examples": [
          {
            "name": "Health check simples",
            "payload": null
          }
        ]
      }
    }
  },
  
